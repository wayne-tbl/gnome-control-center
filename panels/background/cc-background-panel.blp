using Gtk 4.0;
using Adw 1;

template $CcBackgroundPanel: $CcPanel {
  child: Adw.BreakpointBin {
    width-request: 346;
    height-request: 200;

    Adw.Breakpoint {
      condition ("max-width: 420px")

      setters {
        accent_box.spacing: 6;
        accent_box.margin-top: 6;
        accent_box.margin-bottom: 6;
      }
    }

    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {}

      content: Adw.ToastOverlay toast_overlay {
        child: Adw.PreferencesPage {
          Adw.PreferencesGroup status_indicator_group {
            title: _("Status Indicator");

            Adw.SwitchRow weather_status_switch {
              title: _("Weather");
              subtitle: _("Display weather status");
              notify::active => $on_weather_status_switch_active_changed_cb();
            }
          }

          Adw.PreferencesGroup {
            title: _("Style");

            Adw.PreferencesRow {
              accessible-role: group;
              activatable: false;
              focusable: false;

              Adw.Clamp {
                maximum-size: 400;
                tightening-threshold: 300;

                Grid {
                  column-homogeneous: true;
                  column-spacing: 24;
                  row-spacing: 12;
                  margin-start: 12;
                  margin-end: 12;
                  margin-top: 18;
                  margin-bottom: 12;
                  hexpand: true;

                  ToggleButton default_toggle {
                    accessibility {
                      labelled-by: [
                        default_label,
                      ];
                    }

                    notify::active => $on_color_scheme_toggle_active_cb(template);

                    $CcBackgroundPreview default_preview {}

                    styles [
                      "background-preview-button",
                    ]

                    layout {
                      column: 0;
                      row: 0;
                    }
                  }

                  Label default_label {
                    label: _("_Default");
                    use-underline: true;
                    mnemonic-widget: default_toggle;

                    layout {
                      column: 0;
                      row: 1;
                    }
                  }

                  ToggleButton dark_toggle {
                    group: default_toggle;

                    accessibility {
                      labelled-by: [
                        dark_label,
                      ];
                    }

                    notify::active => $on_color_scheme_toggle_active_cb(template);

                    $CcBackgroundPreview dark_preview {
                      is-dark: true;
                    }

                    styles [
                      "background-preview-button",
                    ]

                    layout {
                      column: 1;
                      row: 0;
                    }
                  }

                  Label dark_label {
                    label: _("Da_rk");
                    use-underline: true;
                    mnemonic-widget: dark_toggle;

                    layout {
                      column: 1;
                      row: 1;
                    }
                  }
                }
              }
            }
          }

          Adw.PreferencesGroup {
            title: _("Accent Color");

            Adw.PreferencesRow {
              accessible-role: group;
              activatable: false;
              focusable: false;

              Box accent_box {
                spacing: 12;
                margin-top: 12;
                margin-bottom: 12;
                halign: center;
              }
            }

          }

          Adw.PreferencesGroup recording_group {
            title: _("Screen Recording");
            description: _("The recorder tile only appears if wf-recorder is installed");

            Adw.SwitchRow screen_recorder_switch {
              title: _("Screen Recorder in Quick Settings");

              notify::active => $on_screen_recorder_switch_changed_cb(template);
            }

            Adw.ExpanderRow recorder_expander {
              title: _("Recording Settings");
              subtitle: _("Applied to the next recording");

              Adw.ComboRow recorder_speed_row {
                title: _("Speed");
                subtitle: _("Play the finished recording faster than real time. Applied after recording by restamping the timestamps, so nothing is re-encoded and no quality is lost");

                model: StringList {
                  strings [
                    _("Normal"),
                    _("1.5×"),
                    _("2×"),
                    _("4×"),
                    _("8×"),
                  ]
                };

                notify::selected => $on_recorder_speed_changed_cb(template);
              }

              Adw.ComboRow recorder_codec_row {
                title: _("Codec");
                subtitle: _("This hardware has no usable video encoder, so all of these are software");

                notify::selected => $on_recorder_codec_changed_cb(template);
              }

              Adw.ComboRow recorder_bitrate_row {
                title: _("Bit Rate");
                subtitle: _("Automatic aims at a constant quality instead, which is usually a smaller file for the same picture");

                model: StringList {
                  strings [
                    _("Automatic"),
                    _("4 Mb/s"),
                    _("8 Mb/s"),
                    _("12 Mb/s"),
                  ]
                };

                notify::selected => $on_recorder_bitrate_changed_cb(template);
              }

              Adw.SwitchRow recorder_audio_switch {
                title: _("Record Audio");
              }

              Adw.ComboRow recorder_audio_source_row {
                title: _("Audio Source");

                notify::selected => $on_recorder_audio_source_changed_cb(template);
              }

              Adw.SwitchRow recorder_touches_switch {
                title: _("Show Touches");
                subtitle: _("Mark where the screen is touched while recording");
              }
            }
          }

          Adw.PreferencesGroup screenshot_group {
            title: _("Screenshots");

            Adw.SwitchRow screenshot_switch {
              title: _("Screenshot in Quick Settings");

              notify::active => $on_screenshot_switch_changed_cb(template);
            }

            Adw.ComboRow screenshot_delay_row {
              title: _("Screenshot Delay");
              subtitle: _("Time for the drawer to get out of the picture");

              model: StringList {
                strings [
                  _("1s"),
                  _("2s"),
                  _("3s"),
                  _("4s"),
                  _("5s"),
                ]
              };

              notify::selected => $on_screenshot_delay_changed_cb(template);
            }
          }

          Adw.PreferencesGroup {
            title: _("Background");

            header-suffix: Button {
              Adw.ButtonContent {
                icon-name: "list-add-symbolic";
                label: _("_Add Picture…");
                use-underline: true;
              }

              clicked => $on_add_picture_button_clicked_cb(template);

              styles [
                "flat",
              ]
            };

            Adw.Bin {
              styles [
                "card",
              ]
              accessibility {
                label: _("Background");
              }
              accessible-role: group;

              $CcBackgroundChooser background_chooser {
                hexpand: true;
                toast-overlay: toast_overlay;
                background-chosen => $on_chooser_background_chosen_cb(template);
              }
            }
          }
        };
      };
    };
  };
}
