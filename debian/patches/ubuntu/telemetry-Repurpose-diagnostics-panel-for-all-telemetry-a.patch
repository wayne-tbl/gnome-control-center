+  AdwSwitchRow *insights_upgrade_row;
+
+  AdwButtonRow *insights_example_report_button_row;
+  AdwButtonRow *insights_cancel_report_button_row;
+#endif
+
+  GCancellable *cancellable;
+
+#ifdef HAVE_INSIGHTS
+  GCancellable *insights_cancellable;
+#endif
+
+  GSettings *privacy_settings;
+};
+
+G_DEFINE_TYPE (CcTelemetryPage, cc_telemetry_page, ADW_TYPE_NAVIGATION_PAGE)
+
+/* Static init function */
+
+static gboolean
+string_is_not_empty (CcTelemetryPage *self,
+                     const char      *string)
+{
+  return string && string[0];
+}
+
+static void
+abrt_appeared_cb (GDBusConnection *connection,
+                  const gchar     *name,
+                  const gchar     *name_owner,
+                  gpointer         user_data)
+{
+  g_autofree gchar *whoopsie_url = NULL;
+  CcTelemetryPage  *self = CC_TELEMETRY_PAGE (user_data);
+
+  g_debug ("ABRT appeared");
+  gtk_widget_set_visible (GTK_WIDGET (self), TRUE);
+  gtk_widget_set_visible (GTK_WIDGET (self->diagnostics_group), TRUE);
+}
+
+static void
+abrt_vanished_cb (GDBusConnection *connection,
+                  const gchar     *name,
+                  gpointer         user_data)
+{
+  g_debug ("ABRT vanished");
+#ifndef HAVE_WHOOPSIE
+  CcTelemetryPage *self = CC_TELEMETRY_PAGE (user_data);
+  gtk_widget_set_visible (GTK_WIDGET (self->diagnostics_group), FALSE);
+
+#ifndef HAVE_INSIGHTS
+  gtk_widget_set_visible (GTK_WIDGET (self), FALSE);
+#endif
+#endif
+}
+
+#ifdef HAVE_WHOOPSIE
+typedef enum
+{
+  WHOOPSIE_BUTTON_SETTING_NEVER,
+  WHOOPSIE_BUTTON_SETTING_AUTO,
+  WHOOPSIE_BUTTON_SETTING_MANUAL,
+} WhoopsieButtonSettingType;
+
+static void
+whoopsie_set_report_crashes_done (GObject      *source_object,
+                                  GAsyncResult *res,
+                                  gpointer      user_data)
+{
+  CcTelemetryPage *self = CC_TELEMETRY_PAGE (user_data);
+  g_autoptr (GError) error = NULL;
+
+  if (!whoopsie_preferences_call_set_report_crashes_finish (self->whoopsie, res, &error))
+    {
+      if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+        return;
+
+      g_warning ("Failed to toggle crash reporting: %s", error->message);
+    }
+}
+
+static void
+whoopsie_set_report_crashes_mode_done (GObject      *source_object,
+                                       GAsyncResult *res,
+                                       gpointer      user_data)
+{
+  CcTelemetryPage *self = CC_TELEMETRY_PAGE (user_data);
+  g_autoptr (GError) error = NULL;
+
+  if (!whoopsie_preferences_call_set_automatically_report_crashes_finish (self->whoopsie, res, &error))
+    {
+      if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+        return;
+
+      g_warning ("Failed to toggle crash reporting mode: %s", error->message);
+    }
+}
+
+static void
+whoopsie_combo_row_changed_cb (CcTelemetryPage *self)
+{
+  g_autoptr (GObject) item = NULL;
+  GListModel *model;
+  gint        selected_index;
+  gint        value;
+
+  model = adw_combo_row_get_model (self->whoopsie_combo_row);
+  selected_index = adw_combo_row_get_selected (self->whoopsie_combo_row);
+  if (selected_index == -1)
+    return;
+
+  item = g_list_model_get_item (model, selected_index);
+  value = GPOINTER_TO_UINT (g_object_get_data (G_OBJECT (item), "value"));
+
+  whoopsie_preferences_call_set_report_crashes (self->whoopsie,
+                                                value != WHOOPSIE_BUTTON_SETTING_NEVER,
+                                                self->cancellable,
+                                                whoopsie_set_report_crashes_done,
+                                                self);
+
+  whoopsie_preferences_call_set_automatically_report_crashes (self->whoopsie,
+                                                              value == WHOOPSIE_BUTTON_SETTING_AUTO,
+                                                              self->cancellable,
+                                                              whoopsie_set_report_crashes_mode_done,
+                                                              self);
+}
+
+static void
+set_value_for_combo_row (AdwComboRow *combo_row, gint value)
+{
+  g_autoptr (GObject) new_item = NULL;
+  GListModel *model;
+  guint       i;
+
+  /* try to make the UI match the setting */
+  model = adw_combo_row_get_model (combo_row);
+  for (i = 0; i < g_list_model_get_n_items (model); i++)
+    {
+      g_autoptr (GObject) item = g_list_model_get_item (model, i);
+      gint value_tmp = GPOINTER_TO_UINT (g_object_get_data (item, "value"));
+      if (value_tmp == value)
+        {
+          adw_combo_row_set_selected (combo_row, i);
+          return;
+        }
+    }
+}
+
+static void
+whoopsie_properties_changed (CcTelemetryPage *self)
+{
+  g_autofree char *name_owner = g_dbus_proxy_get_name_owner (G_DBUS_PROXY (self->whoopsie));
+
+  /* Bail out if dbus service has gone away */
+  if (G_UNLIKELY (!name_owner))
+    return;
+
+  WhoopsieButtonSettingType value = WHOOPSIE_BUTTON_SETTING_NEVER;
+
+  if (whoopsie_preferences_get_automatically_report_crashes (self->whoopsie))
+    value = WHOOPSIE_BUTTON_SETTING_AUTO;
+  else if (whoopsie_preferences_get_report_crashes (self->whoopsie))
+    value = WHOOPSIE_BUTTON_SETTING_MANUAL;
+
+  g_signal_handlers_block_by_func (self->whoopsie_combo_row, whoopsie_combo_row_changed_cb, self);
+  set_value_for_combo_row (self->whoopsie_combo_row, value);
+  g_signal_handlers_unblock_by_func (self->whoopsie_combo_row, whoopsie_combo_row_changed_cb, self);
+}
+
+static void
+whoopsie_bus_owner_changed (GDBusProxy *proxy)
+{
+  g_autofree char *name_owner = g_dbus_proxy_get_name_owner (proxy);
+
+  if (!name_owner)
+    {
+      /* Trigger the service to start again, as it has just been stopped by a timeout
+       * don't bother on waiting for the call results.
+       */
+      whoopsie_preferences_call_get_identifier (WHOOPSIE_PREFERENCES (proxy), NULL, NULL, NULL);
+    }
+}
+
+static void
+populate_whoopsie_button_row (AdwComboRow *combo_row)
+{
+  g_autoptr (GtkStringList) string_list = NULL;
+  struct
+  {
+    char                     *name;
+    WhoopsieButtonSettingType value;
+  } actions[] = {
+    { NC_ ("Whoopsie error reporting", "Never"), WHOOPSIE_BUTTON_SETTING_NEVER },
+    { NC_ ("Whoopsie error reporting", "Automatic"), WHOOPSIE_BUTTON_SETTING_AUTO },
+    { NC_ ("Whoopsie error reporting", "Manual"), WHOOPSIE_BUTTON_SETTING_MANUAL },
+  };
+  guint item_index = 0;
+  guint i;
+
+  string_list = gtk_string_list_new (NULL);
+  for (i = 0; i < G_N_ELEMENTS (actions); i++)
+    {
+      g_autoptr (GObject) item = NULL;
+
+      gtk_string_list_append (string_list, _ (actions[i].name));
+
+      item = g_list_model_get_item (G_LIST_MODEL (string_list), item_index++);
+      g_object_set_data (item, "value", GUINT_TO_POINTER (actions[i].value));
+    }
+
+  adw_combo_row_set_model (combo_row, G_LIST_MODEL (string_list));
+}
+
+static void
+on_new_whoopsie_proxy_cb (GObject      *object,
+                          GAsyncResult *res,
+                          gpointer      data)
+{
+  CcTelemetryPage *self = CC_TELEMETRY_PAGE (data);
+  g_autoptr (GError) error = NULL;
+
+  self->whoopsie = whoopsie_preferences_proxy_new_for_bus_finish (res, &error);
+
+  if (error)
+    {
+      if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+        g_warning ("Failed to get whoopsie proxy: %s", error->message);
+
+      gtk_widget_set_visible (GTK_WIDGET (self->whoopsie_combo_row), FALSE);
+      gtk_widget_set_visible (GTK_WIDGET (self->abrt_row), TRUE);
+      return;
+    }
+
+  g_debug ("Whoopsie available");
+  gtk_widget_set_visible (GTK_WIDGET (self), TRUE);
+  gtk_widget_set_visible (GTK_WIDGET (self->whoopsie_combo_row), TRUE);
+  gtk_widget_set_sensitive (GTK_WIDGET (self->whoopsie_combo_row), TRUE);
+
+  g_signal_handlers_block_by_func (self->whoopsie_combo_row,
+                                   whoopsie_combo_row_changed_cb, self);
+  populate_whoopsie_button_row (self->whoopsie_combo_row);
+  g_signal_handlers_unblock_by_func (self->whoopsie_combo_row,
+                                     whoopsie_combo_row_changed_cb, self);
+
+  g_signal_connect_object (self->whoopsie, "g-properties-changed",
+                           G_CALLBACK (whoopsie_properties_changed),
+                           self, G_CONNECT_SWAPPED);
+
+  g_signal_connect_object (self->whoopsie, "notify::g-name-owner",
+                           G_CALLBACK (whoopsie_bus_owner_changed),
+                           self, 0);
+
+  whoopsie_properties_changed (self);
+}
+#else
+static void
+whoopsie_combo_row_changed_cb (CcTelemetryPage *self)
+{
+}
+#endif
+
+#ifdef HAVE_INSIGHTS
+static void update_insights_row_state (CcTelemetryPage *self, AdwSwitchRow *row);
+
+static void
+insights_switch_row_changed_cb (GObject    *object,
+                                GParamSpec *pspec,
+                                gpointer    user_data)
+{
+  AdwSwitchRow    *row = ADW_SWITCH_ROW (object);
+  gboolean         active;
+  const gchar     *source;
+  g_autofree char *error_msg = NULL;
+
+  active = adw_switch_row_get_active (row);
+  source = g_object_get_data (G_OBJECT (row), "insights-source");
+
+  if (!source)
+    return; /* Shouldn't happen */
+
+  error_msg = insights_set_consent_state (NULL,
+                                          source,
+                                          active ? INSIGHTS_CONSENT_TRUE : INSIGHTS_CONSENT_FALSE);
+  if (error_msg != NULL)
+    {
+      g_warning ("Failed to set insights consent state for source '%s': %s", source, error_msg);
+      update_insights_row_state (CC_TELEMETRY_PAGE (user_data), row);
+    }
+}
+
+static void
+update_insights_row_state (CcTelemetryPage *self,
+                           AdwSwitchRow    *row)
+{
+  const char            *source;
+  insights_consent_state state;
+
+  source = g_object_get_data (G_OBJECT (row), "insights-source");
+  if (!source)
+    return; /* Shouldn't happen */
+
+  state = insights_get_consent_state (NULL, source);
+  g_signal_handlers_block_by_func (row, insights_switch_row_changed_cb, self);
+  adw_switch_row_set_active (row, state == INSIGHTS_CONSENT_TRUE);
+  g_signal_handlers_unblock_by_func (row, insights_switch_row_changed_cb, self);
+}
+
+static void
+sync_insights_switches (CcTelemetryPage *self)
+{
+  update_insights_row_state (self, self->insights_linux_row);
+  update_insights_row_state (self, self->insights_upgrade_row);
+}
+
+static void
+on_generate_report_thread (GTask        *task,
+                           gpointer      source_object,
+                           gpointer      task_data,
+                           GCancellable *cancellable)
+{
+  g_autoptr (GError) error = NULL;
+  g_autofree char       *error_msg = NULL;
+  g_autofree char       *report = NULL;
+  insights_compile_flags flags = { 0 };
+
+  error_msg = insights_compile (NULL, &flags, &report);
+  if (error_msg != NULL)
+    {
+      g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_FAILED, "%s", error_msg);
+      return;
+    }
+
+  g_task_return_pointer (task, g_steal_pointer (&report), g_free);
+}
+
+static void
+generate_report_cb (GObject      *source_object,
+                    GAsyncResult *res,
+                    gpointer      user_data)
+{
+  CcTelemetryPage *self = CC_TELEMETRY_PAGE (user_data);
+  g_autofree char *report = NULL;
+  g_autoptr (GError) error = NULL;
+  GtkWidget *window;
+
+  gtk_widget_set_visible (GTK_WIDGET (self->insights_example_report_button_row), TRUE);
+  gtk_widget_set_visible (GTK_WIDGET (self->insights_cancel_report_button_row), FALSE);
+
+  report = g_task_propagate_pointer (G_TASK (res), &error);
+
+  if (error)
+    {
+      if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+        g_warning ("Failed to generate example report: %s", error->message);
+      return;
+    }
+
+  window = cc_telemetry_insights_example_new (report);
+  gtk_window_set_transient_for (GTK_WINDOW (window),
+                                GTK_WINDOW (gtk_widget_get_native (GTK_WIDGET (self))));
+  gtk_window_present (GTK_WINDOW (window));
+}
+
+static void
+insights_example_report_button_row_activated_cb (CcTelemetryPage *self)
+{
+  g_autoptr (GTask) task;
+
+  gtk_widget_set_visible (GTK_WIDGET (self->insights_example_report_button_row), FALSE);
+  gtk_widget_set_visible (GTK_WIDGET (self->insights_cancel_report_button_row), TRUE);
+
+  task = g_task_new (self, self->insights_cancellable, generate_report_cb, self);
+
+  g_task_set_return_on_cancel (task, TRUE);
+  g_task_run_in_thread (task, on_generate_report_thread);
+}
+
+static void
+insights_cancel_report_button_row_activated_cb (CcTelemetryPage *self)
+{
+  g_debug ("User cancelled insights report generation");
+  gtk_widget_set_visible (GTK_WIDGET (self->insights_cancel_report_button_row), FALSE);
+  gtk_widget_set_visible (GTK_WIDGET (self->insights_example_report_button_row), TRUE);
+
+  g_cancellable_cancel (self->insights_cancellable);
+  g_clear_object (&self->insights_cancellable);
+  self->insights_cancellable = g_cancellable_new ();
+}
+
+#else
+static void
+insights_switch_row_changed_cb (GObject    *object,
+                                GParamSpec *pspec,
+                                gpointer    user_data)
+{
+}
+
+static void
+insights_example_report_button_row_activated_cb (CcTelemetryPage *self)
+{
+}
+
+static void
+insights_cancel_report_button_row_activated_cb (CcTelemetryPage *self)
+{
+}
+
+#endif
+
+static void
+cc_telemetry_page_finalize (GObject *object)
+{
+  CcTelemetryPage *self = CC_TELEMETRY_PAGE (object);
+
+  g_clear_object (&self->privacy_settings);
+
+  g_cancellable_cancel (self->cancellable);
+  g_clear_object (&self->cancellable);
+
+#ifdef HAVE_WHOOPSIE
+  g_clear_object (&self->whoopsie);
+#endif
+
+#ifdef HAVE_INSIGHTS
+  g_cancellable_cancel (self->insights_cancellable);
+  g_clear_object (&self->insights_cancellable);
+#endif
+
+  G_OBJECT_CLASS (cc_telemetry_page_parent_class)->finalize (object);
+}
+
+static void
+cc_telemetry_page_class_init (CcTelemetryPageClass *klass)
+{
+  GObjectClass   *oclass = G_OBJECT_CLASS (klass);
+  GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+
+  oclass->finalize = cc_telemetry_page_finalize;
+
+  gtk_widget_class_set_template_from_resource (widget_class, "/org/gnome/control-center/privacy/telemetry/cc-telemetry-page.ui");
+
+  gtk_widget_class_bind_template_child (widget_class, CcTelemetryPage, diagnostics_group);
+  gtk_widget_class_bind_template_child (widget_class, CcTelemetryPage, abrt_row);
+
+  gtk_widget_class_bind_template_child (widget_class, CcTelemetryPage, insights_group);
+  gtk_widget_class_bind_template_child (widget_class, CcTelemetryPage, insights_buttons_group);
+
+#ifdef HAVE_WHOOPSIE
+  gtk_widget_class_bind_template_child (widget_class, CcTelemetryPage, whoopsie_combo_row);
+#endif
+  gtk_widget_class_bind_template_child (widget_class, CcTelemetryPage, diagnostics_learn_more_link_button);
+  gtk_widget_class_bind_template_callback (widget_class, whoopsie_combo_row_changed_cb);
+
+#ifdef HAVE_INSIGHTS
+  gtk_widget_class_bind_template_child (widget_class, CcTelemetryPage, insights_linux_row);
+  gtk_widget_class_bind_template_child (widget_class, CcTelemetryPage, insights_upgrade_row);
+  gtk_widget_class_bind_template_child (widget_class, CcTelemetryPage, insights_example_report_button_row);
+  gtk_widget_class_bind_template_child (widget_class, CcTelemetryPage, insights_cancel_report_button_row);
+#endif
+  gtk_widget_class_bind_template_callback (widget_class, insights_switch_row_changed_cb);
+  gtk_widget_class_bind_template_callback (widget_class, insights_example_report_button_row_activated_cb);
+  gtk_widget_class_bind_template_callback (widget_class, insights_cancel_report_button_row_activated_cb);
+
+  gtk_widget_class_bind_template_callback (widget_class, string_is_not_empty);
+}
+
+#ifdef HAVE_INSIGHTS
+static void
+on_unmap_cb (GtkWidget *widget,
+             gpointer   user_data)
+{
+  CcTelemetryPage *self = CC_TELEMETRY_PAGE (widget);
+
+  if (self->insights_cancellable)
+    {
+      g_cancellable_cancel (self->insights_cancellable);
+      g_object_unref (self->insights_cancellable);
+      self->insights_cancellable = g_cancellable_new ();
+    }
+}
+#endif
+
+static void
+cc_telemetry_page_init (CcTelemetryPage *self)
+{
+  g_autofree gchar *os_name = NULL;
+  g_autofree gchar *whoopsie_url = NULL;
+  g_autofree gchar *whoopsie_msg = NULL;
+  g_autofree gchar *insights_msg = NULL;
+  g_autoptr (GtkCssProvider) provider = NULL;
+
+  gtk_widget_init_template (GTK_WIDGET (self));
+
+#ifdef HAVE_INSIGHTS
+  g_object_set_data (G_OBJECT (self->insights_linux_row), "insights-source", "linux");
+  g_object_set_data (G_OBJECT (self->insights_upgrade_row), "insights-source", "ubuntu_release_upgrader");
+#endif
+
+  g_bus_watch_name (G_BUS_TYPE_SYSTEM,
+                    "org.freedesktop.problems.daemon",
+                    G_BUS_NAME_WATCHER_FLAGS_NONE,
+                    abrt_appeared_cb,
+                    abrt_vanished_cb,
+                    self,
+                    NULL);
+
+  self->privacy_settings = g_settings_new ("org.gnome.desktop.privacy");
+
+  g_settings_bind (self->privacy_settings, "report-technical-problems",
+                   self->abrt_row, "active",
+                   G_SETTINGS_BIND_DEFAULT);
+
+#if defined(HAVE_WHOOPSIE) || defined(HAVE_INSIGHTS)
+  self->cancellable = g_cancellable_new ();
+#endif
+
+#ifdef HAVE_WHOOPSIE
+  /* check for whoopsie */
+  whoopsie_preferences_proxy_new_for_bus (G_BUS_TYPE_SYSTEM,
+                                          G_DBUS_PROXY_FLAGS_NONE,
+                                          "com.ubuntu.WhoopsiePreferences",
+                                          "/com/ubuntu/WhoopsiePreferences",
+                                          self->cancellable,
+                                          on_new_whoopsie_proxy_cb,
+                                          self);
+
+  gtk_widget_set_visible (GTK_WIDGET (self), TRUE);
+  gtk_widget_set_visible (GTK_WIDGET (self->whoopsie_combo_row), TRUE);
+  gtk_widget_set_visible (GTK_WIDGET (self->abrt_row), FALSE);
+  gtk_widget_set_sensitive (GTK_WIDGET (self->whoopsie_combo_row), FALSE);
+#endif
+
+#ifdef HAVE_INSIGHTS
+  self->insights_cancellable = g_cancellable_new ();
+  gtk_widget_set_visible (GTK_WIDGET (self), TRUE);
+  gtk_widget_set_visible (GTK_WIDGET (self->insights_group), TRUE);
+
+  g_signal_connect_swapped (self, "map", G_CALLBACK (sync_insights_switches), self);
+  g_signal_connect (self, "unmap", G_CALLBACK (on_unmap_cb), NULL);
+#endif
+
+  os_name = g_get_os_info (G_OS_INFO_KEY_NAME);
+  if (!os_name)
+    os_name = g_strdup ("GNOME");
+  whoopsie_url = g_get_os_info (G_OS_INFO_KEY_PRIVACY_POLICY_URL);
+  if (whoopsie_url)
+    gtk_link_button_set_uri (self->diagnostics_learn_more_link_button, whoopsie_url);
+
+  /* translators: The '%s' is the distributor's name, such as 'Fedora' */
+  whoopsie_msg = g_strdup_printf (_ ("Help us address technical problems by sharing error reports with the "
+                                     "%s team. Reports are sent anonymously and are scrubbed of personal data."),
+                                  os_name);
+  adw_preferences_group_set_description (self->diagnostics_group, whoopsie_msg);
+
+  /* translators: The '%s' is the distributor's name, such as 'Ubuntu' */
+  insights_msg = g_strdup_printf (_ ("Help us improve %s features and compatibility by sharing system reports with"
+                                     " Canonical. Reports are sent anonymously and do not contain any personal data."),
+                                  os_name);
+
+  adw_preferences_group_set_description (self->insights_group, insights_msg);
+
+  provider = gtk_css_provider_new ();
+  gtk_css_provider_load_from_resource (provider, "/org/gnome/control-center/privacy/telemetry/telemetry.css");
+  gtk_style_context_add_provider_for_display (gdk_display_get_default (),
+                                              GTK_STYLE_PROVIDER (provider),
+                                              GTK_STYLE_PROVIDER_PRIORITY_APPLICATION);
+}
