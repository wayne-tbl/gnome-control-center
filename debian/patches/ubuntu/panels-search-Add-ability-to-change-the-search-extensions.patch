 };
 
 G_DEFINE_TYPE (CcSearchPanelRow, cc_search_panel_row, ADW_TYPE_ACTION_ROW)
@@ -201,6 +204,9 @@ cc_search_panel_row_class_init (CcSearchPanelRowClass *klass)
   gtk_widget_class_bind_template_child (widget_class, CcSearchPanelRow, icon);
   gtk_widget_class_bind_template_child (widget_class, CcSearchPanelRow, switcher);
 
+  gtk_widget_class_bind_template_child (widget_class, CcSearchPanelRow, drag_handle);
+  gtk_widget_class_bind_template_child (widget_class, CcSearchPanelRow, menu_button);
+
   signals[SIGNAL_MOVE_ROW] =
     g_signal_new ("move-row",
                   G_TYPE_FROM_CLASS (object_class),
@@ -219,12 +225,24 @@ const GActionEntry row_entries[] = {
 
 static void
 cc_search_panel_row_init (CcSearchPanelRow *self)
+{
+  gtk_widget_init_template (GTK_WIDGET (self));
+}
+
+static void
+cc_search_panel_row_after_init (CcSearchPanelRow *self)
 {
   GtkDragSource *drag_source;
   GtkDropTarget *drop_target;
   GSimpleActionGroup *group;
 
-  gtk_widget_init_template (GTK_WIDGET (self));
+  if (cc_search_panel_row_is_snap_search_provider (self))
+    {
+      gtk_widget_set_sensitive (self->drag_handle, FALSE);
+      gtk_widget_set_sensitive (self->menu_button, FALSE);
+
+      return;
+    }
 
   drag_source = gtk_drag_source_new ();
   gtk_drag_source_set_actions (drag_source, GDK_ACTION_MOVE);
@@ -264,6 +282,8 @@ cc_search_panel_row_new (GAppInfo *app_info)
   adw_preferences_row_set_title (ADW_PREFERENCES_ROW (self),
                                  g_app_info_get_name (app_info));
 
+  cc_search_panel_row_after_init (self);
+
   return self;
 }
 
@@ -278,3 +298,10 @@ cc_search_panel_row_get_switch (CcSearchPanelRow *self)
 {
   return GTK_WIDGET (self->switcher);
 }
+
+gboolean
+cc_search_panel_row_is_snap_search_provider (CcSearchPanelRow *row)
+{
+  return (g_strcmp0 (g_app_info_get_id (row->app_info), SNAP_STORE_DESKTOP_ID) == 0 ||
+          g_strcmp0 (g_app_info_get_executable (row->app_info), SNAP_BINARY) == 0);
+}
diff --git a/panels/search/cc-search-panel-row.h b/panels/search/cc-search-panel-row.h
