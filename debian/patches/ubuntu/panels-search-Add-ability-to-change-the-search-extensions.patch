+
 G_END_DECLS
diff --git a/panels/search/cc-search-panel.c b/panels/search/cc-search-panel.c
index 5362b67..e7cfa7d 100644
--- a/panels/search/cc-search-panel.c
+++ b/panels/search/cc-search-panel.c
@@ -25,6 +25,9 @@
 #include "cc-search-resources.h"
 #include "cc-ui-util.h"
 
+#include "shell/cc-object-storage.h"
+#include "panels/ubuntu/cc-ubuntu-panel.h"
+
 #include <gio/gdesktopappinfo.h>
 #include <glib/gi18n.h>
 
@@ -41,6 +44,8 @@ struct _CcSearchPanel
   GSettings        *search_settings;
   GHashTable       *sort_order;
 
+  GSettings        *gnome_shell_settings;
+
   CcSearchLocationsPage *locations_page;
 };
 
@@ -49,6 +54,11 @@ CC_PANEL_REGISTER (CcSearchPanel, cc_search_panel)
 #define SHELL_PROVIDER_GROUP "Shell Search Provider"
 #define SEARCH_LOCATIONS_PAGE_PARAM "locations"
 
+#define GNOME_SHELL_SCHEMA "org.gnome.shell"
+#define GNOME_SHELL_ENABLED_EXTENSIONS "enabled-extensions"
+#define GNOME_SHELL_DISABLED_EXTENSIONS "disabled-extensions"
+#define SNAP_SEARCH_EXTENSION_UUID "snapd-search-provider@canonical.com"
+
 static gint
 list_sort_func (gconstpointer a,
                 gconstpointer b,
@@ -60,6 +70,12 @@ list_sort_func (gconstpointer a,
   gint idx_a, idx_b;
   gpointer lookup;
 
+  if (cc_search_panel_row_is_snap_search_provider (CC_SEARCH_PANEL_ROW ((gpointer*)a)))
+    return -1;
+
+  if (cc_search_panel_row_is_snap_search_provider (CC_SEARCH_PANEL_ROW ((gpointer*)b)))
+    return 1;
+
   app_a = cc_search_panel_row_get_app_info (CC_SEARCH_PANEL_ROW ((gpointer*)a));
   app_b = cc_search_panel_row_get_app_info (CC_SEARCH_PANEL_ROW ((gpointer*)b));
 
@@ -589,12 +605,117 @@ populate_search_providers (CcSearchPanel *self)
   g_task_run_in_thread (task, search_providers_discover_thread);
 }
 
+static void
+on_extensions_listed (GObject *source_object,
+                      GAsyncResult *res,
+                      gpointer user_data)
+{
+  CcSearchPanelRow *row = user_data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) response = NULL;
+  g_autoptr (GVariant) extensions = NULL;
+  GVariantIter iter;
+  GVariant *value;
+  const char *uuid;
+
+  response = g_dbus_proxy_call_finish (G_DBUS_PROXY (source_object), res, &error);
+
+  if (error)
+    {
+      if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+        g_warning ("Failed to get gnome-shell extensions: %s", error->message);
+      return;
+    }
+
+  extensions = g_variant_get_child_value (response, 0);
+
+  double snapd_search_state = CC_UBUNTU_PANEL_SHELL_EXTENSION_STATE_UNINSTALLED;
+
+  g_variant_iter_init (&iter, extensions);
+  while (g_variant_iter_loop (&iter, "{&s@a{sv}}", &uuid, &value))
+    {
+      g_autoptr (GVariantDict) info = NULL;
+
+      if (g_str_equal (uuid, SNAP_SEARCH_EXTENSION_UUID))
+        {
+          info = g_variant_dict_new (value);
+          g_variant_dict_lookup (info, "state", "d", &snapd_search_state);
+        }
+    }
+
+  cc_ubuntu_panel_update_extension_widgets (GTK_WIDGET (row),
+                                            cc_search_panel_row_get_switch (row),
+                                            SNAP_SEARCH_EXTENSION_UUID,
+                                            snapd_search_state,
+                                            TRUE);
+}
+
+typedef struct
+{
+  CcSearchPanel *self;
+  CcSearchPanelRow *row;
+} ShellExtensionData;
+
+static void
+shell_extensions_proxy_ready (GObject            *source,
+                              GAsyncResult       *res,
+                              gpointer            user_data)
+{
+  g_autofree ShellExtensionData *data = user_data;
+  g_autoptr(GDBusProxy) proxy = NULL;
+  g_autoptr(GError) error = NULL;
+
+  proxy = cc_object_storage_create_dbus_proxy_finish (res, &error);
+  if (!proxy)
+    {
+      if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+        g_warning ("Failed to contact gnome-shell extensions: %s", error->message);
+      return;
+    }
+
+  g_object_set_data_full (G_OBJECT (data->self), "shell-proxy",
+                          g_object_ref (proxy), g_object_unref);
+
+  g_dbus_proxy_call (proxy,
+                     "ListExtensions",
+                     NULL, G_DBUS_CALL_FLAGS_NONE,
+                     -1, cc_panel_get_cancellable (CC_PANEL (data->self)),
+                     (GAsyncReadyCallback) on_extensions_listed, data->row);
+}
+
+static void
+update_snapd_search_provider_status (CcSearchPanelRow *row,
+                                     const char *key,
+                                     GSettings *gnome_shell_settings)
+{
+  gboolean extension_enabled = TRUE;
+
+  if (cc_ubuntu_panel_util_is_extension_disabled (gnome_shell_settings,
+                                                  SNAP_SEARCH_EXTENSION_UUID))
+    extension_enabled = FALSE;
+
+  gtk_switch_set_active (GTK_SWITCH (cc_search_panel_row_get_switch (row)),
+                         extension_enabled);
+}
+
+static void
+on_snapd_search_switch_changed (CcSearchPanel *self,
+                                GParamSpec *pspec,
+                                GtkSwitch *widget)
+{
+  gboolean active = gtk_switch_get_active (widget);
+
+  cc_ubuntu_panel_util_set_extension_enabled (self->gnome_shell_settings,
+                                              SNAP_SEARCH_EXTENSION_UUID,
+                                              active);
+}
 
 static void
 cc_search_panel_finalize (GObject *object)
 {
   CcSearchPanel *self = CC_SEARCH_PANEL (object);
 
+  g_clear_object (&self->gnome_shell_settings);
   g_clear_object (&self->search_settings);
   g_hash_table_destroy (self->sort_order);
 
@@ -639,6 +760,69 @@ cc_search_panel_init (CcSearchPanel *self)
   search_panel_invalidate_sort_order (self);
 
   populate_search_providers (self);
+
+  CcSearchPanelRow *row;
+  g_autoptr(GAppInfo) app_info = NULL;
+  g_autoptr(GDesktopAppInfo) desktop_app_info = NULL;
+  g_autofree char *snap_path = NULL;
+  GSettingsSchemaSource *schema_source = g_settings_schema_source_get_default ();
+  g_autoptr(GSettingsSchema) schema = NULL;
+
+  if ((desktop_app_info = g_desktop_app_info_new (SNAP_STORE_DESKTOP_ID)))
+    {
+      app_info = G_APP_INFO (g_steal_pointer (&desktop_app_info));
+    }
+  else if ((snap_path = g_find_program_in_path (SNAP_BINARY)))
+    {
+      app_info = g_app_info_create_from_commandline (SNAP_BINARY,
+                                                     _("Snap Search Provider"),
+                                                     G_APP_INFO_CREATE_NONE, NULL);
+    }
+
+  if (!app_info)
+    return;
+
+  schema = g_settings_schema_source_lookup (schema_source, GNOME_SHELL_SCHEMA, TRUE);
+  if (!schema)
+    {
+      g_warning ("No GNOME Shell is installed here. Please fix your installation.");
+      return;
+    }
+
+  self->gnome_shell_settings = g_settings_new_full (schema, NULL, NULL);
+
+  row = cc_search_panel_row_new (app_info);
+  g_object_set_data (G_OBJECT (row), "self", self);
+  gtk_list_box_append (GTK_LIST_BOX (self->list_box), GTK_WIDGET (row));
+
+  g_signal_connect_object (cc_search_panel_row_get_switch (row),
+                           "notify::active",
+                           G_CALLBACK (on_snapd_search_switch_changed),
+                           self,
+                           G_CONNECT_SWAPPED);
+
+  ShellExtensionData *extension_data = g_new0 (ShellExtensionData, 1);
+  extension_data->self = self;
+  extension_data->row = row;
+
+  cc_object_storage_create_dbus_proxy (G_BUS_TYPE_SESSION,
+                                       G_DBUS_PROXY_FLAGS_DO_NOT_LOAD_PROPERTIES |
+                                       G_DBUS_PROXY_FLAGS_DO_NOT_CONNECT_SIGNALS,
+                                       "org.gnome.Shell.Extensions",
+                                       "/org/gnome/Shell/Extensions",
+                                       "org.gnome.Shell.Extensions",
+                                       cc_panel_get_cancellable (CC_PANEL (self)),
+                                       (GAsyncReadyCallback) shell_extensions_proxy_ready,
+                                       g_steal_pointer (&extension_data));
+
+  g_signal_connect_object (self->gnome_shell_settings,
+                           "changed::" GNOME_SHELL_DISABLED_EXTENSIONS,
+                           G_CALLBACK (update_snapd_search_provider_status),
+                           row,
+                           G_CONNECT_SWAPPED);
+
+  update_snapd_search_provider_status (row, GNOME_SHELL_DISABLED_EXTENSIONS,
+                                       self->gnome_shell_settings);
 }
 
 static void
