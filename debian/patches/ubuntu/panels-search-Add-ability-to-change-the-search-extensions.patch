 CcSearchPanelRow *cc_search_panel_row_new          (GAppInfo *app_info);
 
@@ -34,4 +37,6 @@ GAppInfo         *cc_search_panel_row_get_app_info (CcSearchPanelRow *row);
 
 GtkWidget        *cc_search_panel_row_get_switch   (CcSearchPanelRow *row);
 
